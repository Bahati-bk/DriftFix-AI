generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationMembers OrganizationMember[]
  auditActions       AuditAction[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  repositories Repository[]
  evidence     EvidenceRecord[]
  auditReports AuditReport[]
  integrations Integration[]
  policies     Policy[]
  subscription  Subscription?
  usageRecords  UsageRecord[]
}

model OrganizationMember {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  role           String @default("MEMBER")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model Repository {
  id             String   @id @default(cuid())
  organizationId String
  githubRepoId   Int?
  owner          String
  name           String
  fullName       String
  defaultBranch  String   @default("main")
  language       String?
  visibility     String   @default("private")
  framework      String   @default("soc2")
  connectedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  pullRequests PullRequest[]
  evidence     EvidenceRecord[]
}

model PullRequest {
  id             String   @id @default(cuid())
  repositoryId   String
  githubPrId     Int?
  number         Int
  title          String
  author         String
  sourceBranch   String
  targetBranch   String
  status         String   @default("open")
  body           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repository  Repository  @relation(fields: [repositoryId], references: [id])
  analysisRuns AnalysisRun[]
}

model AnalysisRun {
  id              String   @id @default(cuid())
  pullRequestId   String
  status          String   @default("pending")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?
  score           Float    @default(100)
  filesAnalyzed   Int      @default(0)
  findingsCount   Int      @default(0)
  summary         String?
  createdAt       DateTime @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id])
  findings    Finding[]
}

model Finding {
  id              String    @id @default(cuid())
  analysisRunId   String
  category        String
  title           String
  description     String
  severity        String
  confidence      Float     @default(0.0)
  status          String    @default("OPEN")
  filePath        String?
  lineStart       Int?
  lineEnd         Int?
  evidence        String?
  impact          String?
  recommendation   String?
  aiExplanation   String?
  suggestedFix    String?
  dismissReason   String?
  actionLevel     String    @default("INFO")
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  analysisRun       AnalysisRun        @relation(fields: [analysisRunId], references: [id])
  complianceMappings ComplianceMapping[]
  notes             FindingNote[]
}

model ComplianceMapping {
  id          String  @id @default(cuid())
  findingId   String
  framework   String
  control     String
  controlName String?
  rationale   String?

  finding Finding @relation(fields: [findingId], references: [id])
}

model Rule {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String
  description  String
  severity     String   @default("MEDIUM")
  enabled      Boolean  @default(true)
  configuration String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EvidenceRecord {
  id             String   @id @default(cuid())
  organizationId String?
  repositoryId   String?
  findingId      String?
  eventType      String
  actor          String?
  payload        String?
  hash           String?
  previousHash   String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  repository   Repository?   @relation(fields: [repositoryId], references: [id])
}

model AuditReport {
  id             String   @id @default(cuid())
  organizationId String?
  framework      String
  generatedBy    String?
  reportData     String?
  integrityHash  String?
  generatedAt    DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  repositoryId   String?
  eventType      String
  deliveryId     String?
  payload        String?
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Integration {
  id                  String   @id @default(cuid())
  organizationId      String?
  provider            String
  status              String   @default("disconnected")
  credentialsRef      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
}

model Policy {
  id             String   @id @default(cuid())
  organizationId String?
  name           String   @default("default")
  blockOnCritical Boolean  @default(true)
  blockOnHigh    Boolean  @default(true)
  blockOnMedium  Boolean  @default(false)
  minimumScore   Int      @default(80)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
}

model AuditAction {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  before    String?
  after     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model FindingNote {
  id        String   @id @default(cuid())
  findingId String
  author    String
  content   String
  createdAt DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
}

model ComplianceScoreHistory {
  id             String   @id @default(cuid())
  organizationId String?
  repositoryId   String?
  score          Int
  weekLabel      String
  createdAt      DateTime @default(now())
}

model Subscription {
  id                  String    @id @default(cuid())
  organizationId      String
  stripeCustomerId   String?
  stripeSubscriptionId String?
  stripePriceId       String?
  status              String    @default("free")
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId])
}

model UsageRecord {
  id              String   @id @default(cuid())
  organizationId  String
  month           String
  prsAnalyzed     Int      @default(0)
  prsIncluded     Int      @default(50)
  overagePrs      Int      @default(0)
  overageCostCents Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, month])
}
